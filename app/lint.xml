<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
      These legacy weather, shortcut, clock, and wallpaper bitmaps are loaded by
      resource name and rely on the existing Android density scaling behavior.
      Moving them to drawable-nodpi would change their rendered size.
    -->
    <issue id="IconLocation">
        <ignore regexp="src[\\/]main[\\/]res[\\/]drawable[\\/].*\.png$" />
    </issue>

    <!-- Progressive accessibility and text-sizing attributes are intentionally
         ignored by Android versions below the API level that introduced them. -->
    <issue id="UnusedAttribute">
        <ignore regexp="src[\\/]main[\\/]res[\\/]layout(?:-v\d+)?[\\/]container_main_.*\.xml$" />
    </issue>

    <!-- RemoteViews updates depend on stable widget hierarchy and view IDs. -->
    <issue id="UselessParent">
        <ignore regexp="src[\\/]main[\\/]res[\\/]layout[\\/](?:widget_.*|item_location_card)\.xml$" />
    </issue>

    <!-- Weather layers use stable, dynamically constructed resource names;
         identical pixels do not make the semantic layers interchangeable. -->
    <issue id="IconDuplicates">
        <ignore regexp="src[\\/]main[\\/]res[\\/]drawable[\\/]weather_.*\.png$" />
        <ignore regexp="src[\\/]res_fork[\\/]mipmap-[^\\/]+[\\/]ic_launcher_.*\.png$" />
    </issue>

    <!-- Adaptive/vector launchers and density-specific legacy fallbacks coexist intentionally. -->
    <issue id="IconXmlAndPng">
        <ignore regexp="src[\\/]res_fork[\\/].*ic_launcher_foreground.*" />
    </issue>

    <!-- These artwork vectors intentionally preserve detailed source geometry. -->
    <issue id="VectorPath">
        <ignore regexp="src[\\/](?:main[\\/]res|res_nonfreenet)[\\/].*(?:accu_icon|clock_shape|uv_).*\.xml$" />
    </issue>
    <issue id="VectorRaster">
        <ignore regexp="src[\\/]main[\\/]res[\\/]drawable[\\/]humidity_percent_.*\.xml$" />
    </issue>

    <!-- Android still requires the legacy iw/in aliases alongside he/id. -->
    <issue id="LocaleFolder">
        <ignore regexp="src[\\/](?:main[\\/]res|res_fork)[\\/]values-(?:he|id)$" />
    </issue>

    <!-- CH1 and meteoswiss_icon_ch1 are provider identifiers, not prose. -->
    <issue id="Typos">
        <ignore regexp="src[\\/]main[\\/]res[\\/]values[\\/]arrays\.xml$" />
    </issue>

    <!-- These activity roots deliberately provide their own opaque surfaces;
         the line item is itself a separator whose background is its content. -->
    <issue id="Overdraw">
        <ignore regexp="src[\\/]main[\\/]res[\\/]layout[\\/](?:activity_camera|activity_card_display_manage|activity_daily_trend_display_manage|activity_details_overview_display_manage|activity_hourly_trend_display_manage|activity_preview_icon|item_line)\.xml$" />
    </issue>

    <!-- Phone navigation uses one fragment host, while the expanded tablet
         layout intentionally exposes separate drawer and home hosts. -->
    <issue id="InconsistentLayout">
        <ignore regexp="src[\\/]main[\\/]res[\\/]layout(?:-w640dp)?[\\/]activity_main\.xml$" />
    </issue>

    <!-- Weather resources and the system navigation-bar workaround are looked
         up dynamically because their names or framework availability vary. -->
    <issue id="DiscouragedApi">
        <ignore regexp="src[\\/]main[\\/]kotlin[\\/].*(?:ResourceUtils|AbstractWidgetConfigActivity)\.kt$" />
    </issue>
    <issue id="InternalInsetResource">
        <ignore regexp="src[\\/]main[\\/]kotlin[\\/].*AbstractWidgetConfigActivity\.kt$" />
    </issue>

    <!-- These hierarchies retain stable IDs and distinct interactive/accessibility behavior. -->
    <issue id="UseCompoundDrawables">
        <ignore regexp="src[\\/]main[\\/]res[\\/]layout[\\/]container_main_radar\.xml$" />
    </issue>

    <!-- Dynamic location shortcuts are replaced as a set; usage is recorded by
         normal activity navigation rather than at creation time. -->
    <issue id="ReportShortcutUsage">
        <ignore regexp="src[\\/]main[\\/]kotlin[\\/].*RefreshHelper\.kt$" />
    </issue>
</lint>
