import kotlin.Boolean;

CREATE TABLE wallpaper_photos(
    id TEXT NOT NULL PRIMARY KEY,
    source_url TEXT UNIQUE,
    location_key TEXT NOT NULL,
    location_name TEXT NOT NULL,
    file_path TEXT,
    attribution TEXT,
    processed INTEGER AS Boolean NOT NULL DEFAULT 1,
    rating INTEGER NOT NULL DEFAULT 0,
    disabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    view_count INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    last_shown_at INTEGER,
    day_period TEXT,
    country TEXT,
    season TEXT,
    exif_lat REAL,
    exif_lon REAL,
    source TEXT,
    provider_name TEXT,
    title TEXT,
    page_url TEXT,
    owner_name TEXT,
    license TEXT,
    processed_location TEXT,
    status TEXT,
    source_location TEXT,
    captured_at TEXT,
    description TEXT,
    resolved_city TEXT,
    is_city INTEGER AS Boolean,
    scene_type TEXT,
    weather TEXT,
    resolved_lat REAL,
    resolved_lon REAL
);

CREATE INDEX wallpaper_photos_location_idx ON wallpaper_photos(location_key);
CREATE INDEX wallpaper_photos_disabled_idx ON wallpaper_photos(disabled);

getAll:
SELECT * FROM wallpaper_photos
ORDER BY disabled ASC, location_name COLLATE NOCASE ASC, rating DESC, view_count ASC, updated_at DESC;

getForLocation:
SELECT * FROM wallpaper_photos
WHERE location_key = :locationKey
ORDER BY disabled ASC, rating DESC, view_count ASC, updated_at DESC;

getById:
SELECT * FROM wallpaper_photos WHERE id = :id;

getDisabledSourceUrls:
SELECT source_url FROM wallpaper_photos
WHERE disabled = 1 AND source_url IS NOT NULL;

upsertDownloaded:
INSERT INTO wallpaper_photos(
    id, source_url, location_key, location_name, file_path, attribution, processed,
    rating, disabled, view_count, created_at, updated_at, last_shown_at,
    day_period, country, season, exif_lat, exif_lon,
    source, provider_name, title, page_url, owner_name, license, processed_location,
    status, source_location, captured_at, description, resolved_city, is_city,
    scene_type, weather, resolved_lat, resolved_lon
)
VALUES (
    :id, :sourceUrl, :locationKey, :locationName, :filePath, :attribution, :processed,
    0, 0, 0, :now, :now, NULL,
    :dayPeriod, :country, :season, :exifLat, :exifLon,
    :source, :providerName, :title, :pageUrl, :ownerName, :license, :processedLocation,
    :status, :sourceLocation, :capturedAt, :description, :resolvedCity, :isCity,
    :sceneType, :weather, :resolvedLat, :resolvedLon
)
ON CONFLICT(id) DO UPDATE SET
    source_url = coalesce(excluded.source_url, source_url),
    location_key = excluded.location_key,
    location_name = excluded.location_name,
    file_path = excluded.file_path,
    attribution = coalesce(excluded.attribution, attribution),
    processed = excluded.processed,
    updated_at = excluded.updated_at,
    day_period = coalesce(excluded.day_period, day_period),
    country = coalesce(excluded.country, country),
    season = coalesce(excluded.season, season),
    exif_lat = coalesce(excluded.exif_lat, exif_lat),
    exif_lon = coalesce(excluded.exif_lon, exif_lon),
    source = coalesce(excluded.source, source),
    provider_name = coalesce(excluded.provider_name, provider_name),
    title = coalesce(excluded.title, title),
    page_url = coalesce(excluded.page_url, page_url),
    owner_name = coalesce(excluded.owner_name, owner_name),
    license = coalesce(excluded.license, license),
    processed_location = coalesce(excluded.processed_location, processed_location),
    status = coalesce(excluded.status, status),
    source_location = coalesce(excluded.source_location, source_location),
    captured_at = coalesce(excluded.captured_at, captured_at),
    description = coalesce(excluded.description, description),
    resolved_city = coalesce(excluded.resolved_city, resolved_city),
    is_city = coalesce(excluded.is_city, is_city),
    scene_type = coalesce(excluded.scene_type, scene_type),
    weather = coalesce(excluded.weather, weather),
    resolved_lat = coalesce(excluded.resolved_lat, resolved_lat),
    resolved_lon = coalesce(excluded.resolved_lon, resolved_lon);

setRating:
UPDATE wallpaper_photos
SET rating = :rating, updated_at = :now
WHERE id = :id;

setDisabled:
UPDATE wallpaper_photos
SET disabled = :disabled,
    file_path = CASE WHEN :disabled THEN NULL ELSE file_path END,
    updated_at = :now
WHERE id = :id;

markShown:
UPDATE wallpaper_photos
SET view_count = view_count + 1,
    last_shown_at = :now,
    updated_at = :now
WHERE id = :id;

clearFilePath:
UPDATE wallpaper_photos
SET file_path = NULL, updated_at = :now
WHERE id = :id;

clearAllFilePaths:
UPDATE wallpaper_photos
SET file_path = NULL, updated_at = :now
WHERE file_path IS NOT NULL;

deleteForLocation:
DELETE FROM wallpaper_photos WHERE location_key = :locationKey;

deleteById:
DELETE FROM wallpaper_photos WHERE id = :id;
